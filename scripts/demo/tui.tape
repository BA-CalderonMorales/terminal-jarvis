Output demo-tui.gif
Set FontSize 14
Set Width 1000
Set Height 640
Set Padding 20
Set Shell bash

Type "export TERMINAL_JARVIS_HOME=$(mktemp -d)"
Enter
Type "./target/release/terminal-jarvis tui"
Enter
Sleep 2s
Type "list"
Enter
Sleep 2s
Type "status"
Enter
Sleep 2s
Type "/theme moss"
Enter
Sleep 2s
Type "/theme default"
Enter
Sleep 2s
Type "help"
Enter
Sleep 2s
Type "exit"
Enter
Sleep 1s
